---
// A 3D photo-lab backdrop made from CSS only: striped sun, gridded floor rushing
// toward you, and photo prints floating at different depths. It sits behind the page.
interface Props {
	/** Only show this scene in the Miami theme (used on pages that are plain in the classic theme). */
	gtaOnly?: boolean;
}
const { gtaOnly = false } = Astro.props;

// Miami skyline: two layers of buildings, far and near, each with its own window colour.
const wins = ['#19e3d8', '#ff2e93', '#ffb23f', '#b266ff'];
const far = Array.from({ length: 28 }, (_, i) => ({
	l: i * 3.7 - 3,
	w: 3.4 + ((i * 7) % 5) * 0.55,
	h: 8 + ((i * 13) % 9) * 2.6,
	c: wins[i % 4],
}));
const near = Array.from({ length: 15 }, (_, i) => ({
	l: i * 7.3 - 3,
	w: 5.2 + ((i * 5) % 4) * 0.9,
	h: 5 + ((i * 11) % 7) * 2.1,
	c: wins[(i + 2) % 4],
}));

const prints = [
	{ x: 'calc(-1 * max(22rem, 34vw))', y: '-14vh', z: '-120px', r: '-14deg', ry: '24deg', s: 1, d: '0s', c: 1 },
	{ x: 'max(22rem, 33vw)', y: '-24vh', z: '-260px', r: '10deg', ry: '-28deg', s: 1.2, d: '-2s', c: 2 },
	{ x: 'calc(-1 * max(24rem, 38vw))', y: '16vh', z: '60px', r: '8deg', ry: '30deg', s: 0.8, d: '-4s', c: 3 },
	{ x: 'max(25rem, 40vw)', y: '10vh', z: '-40px', r: '-9deg', ry: '-24deg', s: 0.9, d: '-1s', c: 1 },
	{ x: 'calc(-1 * max(18rem, 22vw))', y: '-34vh', z: '-380px', r: '5deg', ry: '14deg', s: 1.1, d: '-3s', c: 2 },
	{ x: 'max(19rem, 24vw)', y: '30vh', z: '-200px', r: '-6deg', ry: '-18deg', s: 0.7, d: '-5s', c: 3 },
];
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
	<defs>
		<g id="palm" fill="currentColor">
			<path d="M96 320 C92 240 100 160 122 84 L132 86 C112 164 106 240 112 320Z" />
			<path d="M126 84 Q80 30 6 84 Q76 58 126 84Z" />
			<path d="M126 84 Q60 66 14 150 Q70 92 126 84Z" />
			<path d="M126 84 Q120 20 56 4 Q108 36 126 84Z" />
			<path d="M126 84 Q150 24 214 26 Q154 44 126 84Z" />
			<path d="M126 84 Q186 56 226 120 Q176 84 126 84Z" />
			<path d="M126 84 Q170 90 196 160 Q160 110 126 84Z" />
		</g>
	</defs>
</svg>
<div class:list={["scene", { "gta-only": gtaOnly }]} aria-hidden="true">
	<div class="stage">
		<div class="sun"></div>
		<div class="skyline far">
			{far.map((b) => <i style={`--l:${b.l}vw;--w:${b.w}vw;--h:${b.h}vh;--win:${b.c}`} />)}
		</div>
		<div class="skyline near">
			{near.map((b) => <i style={`--l:${b.l}vw;--w:${b.w}vw;--h:${b.h}vh;--win:${b.c}`} />)}
		</div>
		<div class="car"><i></i><i></i></div>
		<div class="floor"><div class="grid"></div></div>
		<svg class="palm palm-l" viewBox="0 0 200 320" aria-hidden="true"><use href="#palm" /></svg>
		<svg class="palm palm-r" viewBox="0 0 200 320" aria-hidden="true"><use href="#palm" /></svg>
		<div class="prints">
			{
				prints.map((p) => (
					<div
						class="print"
						style={`--x:${p.x};--y:${p.y};--z:${p.z};--r:${p.r};--ry:${p.ry};--s:${p.s};--d:${p.d}`}
					>
						<div class="print-inner">
							<div class={`photo tone-${p.c}`} />
						</div>
					</div>
				))
			}
		</div>
	</div>
	<div class="vignette"></div>
</div>

<style>
	.scene {
		position: fixed;
		inset: 0;
		overflow: hidden;
		z-index: -1;
		pointer-events: none;
		perspective: 900px;
		perspective-origin: 50% 40%;
		--mx: 0;
		--my: 0;
	}
	.stage {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transform: rotateX(calc(var(--my) * -3deg)) rotateY(calc(var(--mx) * 4deg));
		transition: transform 0.4s ease-out;
	}

	/* Striped retro sun sitting on the horizon */
	.sun {
		position: absolute;
		left: 50%;
		top: 58vh;
		width: min(52vmin, 26rem);
		aspect-ratio: 1;
		translate: -50% -100%;
		border-radius: 50%;
		background: linear-gradient(to bottom, var(--sun-a, #f2b632) 10%, var(--sun-b, #e8742c) 55%, var(--sun-c, #c8412b) 90%);
		/* horizontal slits that grow toward the bottom, like a 70s sunset */
		--slits: linear-gradient(
			to bottom,
			#000 0 52%,
			transparent 52% 56%,
			#000 56% 63%,
			transparent 63% 69%,
			#000 69% 76%,
			transparent 76% 83%,
			#000 83% 90%,
			transparent 90% 100%
		);
		-webkit-mask-image: var(--slits);
		mask-image: var(--slits);
		opacity: 0.55;
		filter: drop-shadow(0 0 3rem rgba(var(--grid-rgb, 242, 182, 50), 0.3));
		animation: sun-breathe 9s ease-in-out infinite;
	}

	/* Floor: a perspective grid that slides toward the viewer */
	.floor {
		position: absolute;
		left: -50%;
		right: -50%;
		top: 58vh;
		height: 90vh;
		transform-origin: 50% 0;
		transform: rotateX(72deg);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 92%);
		mask-image: linear-gradient(to bottom, #000 0%, transparent 92%);
	}
	.grid {
		position: absolute;
		left: 0;
		right: 0;
		top: -80px;
		bottom: 0;
		background-image:
			linear-gradient(to right, rgba(var(--grid-rgb, 242, 182, 50), 0.4) 2px, transparent 2px),
			linear-gradient(to bottom, rgba(var(--grid-rgb, 242, 182, 50), 0.4) 2px, transparent 2px);
		background-size: 80px 80px;
		animation: grid-run 2.4s linear infinite;
	}
	.floor::before {
		/* soft glow on the horizon line */
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 14%;
		background: linear-gradient(to bottom, rgba(var(--grid-rgb, 242, 182, 50), 0.45), transparent);
		z-index: 1;
	}

	/* Floating photo prints */
	.prints {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
	}
	.print {
		position: absolute;
		left: 50%;
		top: 50%;
		transform-style: preserve-3d;
		transform: translate3d(calc(var(--x) + var(--mx) * var(--z) * -0.06), calc(var(--y) + var(--my) * var(--z) * -0.06), var(--z));
		transition: transform 0.4s ease-out;
	}
	.print-inner {
		width: 9.5rem;
		padding: 0.6rem 0.6rem 2.2rem;
		margin: -6rem 0 0 -4.75rem;
		background: var(--paper);
		box-shadow: 8px 10px 0 rgba(0, 0, 0, 0.25);
		scale: var(--s);
		transform-style: preserve-3d;
		animation: drift 11s ease-in-out infinite;
		animation-delay: var(--d);
	}
	.photo {
		aspect-ratio: 1;
		background-size: cover;
	}
	.tone-1 {
		background:
			radial-gradient(circle at 70% 30%, #f2b632 0 14%, transparent 15%),
			linear-gradient(to bottom, #e8742c 0 55%, #163f3a 55%);
	}
	.tone-2 {
		background:
			radial-gradient(circle at 30% 65%, #f4efe2 0 12%, transparent 13%),
			linear-gradient(135deg, #c8412b, #e8742c 60%, #f2b632);
	}
	.tone-3 {
		background:
			linear-gradient(to bottom, #35655d 0 45%, #f2b632 45% 60%, #163f3a 60%);
	}

	.gta-only {
		display: none;
	}
	:global(html[data-theme='gta']) .gta-only {
		display: block;
	}

	/* Miami skyline: buildings with lit windows, in two depth layers that shift against each other */
	.skyline {
		display: none;
		position: absolute;
		inset: 0;
		pointer-events: none;
		transform-style: preserve-3d;
	}
	:global(html[data-theme='gta']) .skyline {
		display: block;
	}
	.skyline i {
		position: absolute;
		left: var(--l);
		top: 58vh;
		width: var(--w);
		height: var(--h);
		translate: 0 -100%;
		border-top: 2px solid var(--win);
		box-shadow: 0 -4px 18px color-mix(in srgb, var(--win) 55%, transparent);
	}
	.skyline.far {
		transform: translateZ(10px) translateX(calc(var(--mx) * -7px));
		opacity: 0.7;
	}
	.skyline.far i {
		background:
			repeating-linear-gradient(90deg, transparent 0 5px, #1c0a3d 5px 8px),
			repeating-linear-gradient(0deg, transparent 0 7px, #1c0a3d 7px 11px),
			linear-gradient(color-mix(in srgb, var(--win) 32%, #1c0a3d), color-mix(in srgb, var(--win) 32%, #1c0a3d));
	}
	.skyline.near {
		transform: translateZ(30px) translateX(calc(var(--mx) * -16px));
		opacity: 0.85;
	}
	.skyline.near i {
		background:
			repeating-linear-gradient(90deg, transparent 0 7px, #0d0322 7px 11px),
			repeating-linear-gradient(0deg, transparent 0 9px, #0d0322 9px 14px),
			linear-gradient(color-mix(in srgb, var(--win) 42%, #0d0322), color-mix(in srgb, var(--win) 42%, #0d0322));
	}

	/* A car cruising along the horizon */
	.car {
		display: none;
		position: absolute;
		left: 0;
		top: calc(58vh + 1.2vh);
		width: 1.6rem;
		height: 0.4rem;
		border-radius: 2px;
		background: #05010f;
		transform: translateZ(40px);
		animation: cruise 14s linear infinite;
	}
	:global(html[data-theme='gta']) .car {
		display: block;
	}
	.car i {
		position: absolute;
		top: 0.1rem;
		width: 0.25rem;
		height: 0.2rem;
		border-radius: 50%;
		background: #ff3b3b;
		box-shadow: 0 0 10px 3px rgba(255, 59, 59, 0.9);
	}
	.car i:first-child { left: 0.1rem; }
	.car i:last-child { right: 0.1rem; }
	@keyframes cruise {
		from { translate: -12vw 0; }
		to { translate: 112vw 0; }
	}

	:global(html[data-theme='gta']) .prints {
		display: none;
	}
	.palm {
		display: none;
		position: absolute;
		top: 58vh;
		height: min(46vh, 28rem);
		width: auto;
		translate: calc(var(--mx) * -26px) -94%;
		z-index: 3;
		color: #0a0218;
		filter: drop-shadow(0 0 1.2rem rgba(255, 46, 147, 0.55));
		transform-origin: 50% 100%;
		animation: sway 7s ease-in-out infinite;
	}
	.palm-l {
		left: max(-1rem, 2vw);
	}
	.palm-r {
		right: max(-1rem, 2vw);
		scale: -0.85 0.85;
		translate: calc(var(--mx) * 26px) -94%;
		animation-delay: -3s;
	}
	:global(html[data-theme='gta']) .palm {
		display: block;
	}
	@media (max-width: 40rem) {
		.palm {
			height: 30vh;
		}
	}
	@keyframes sway {
		50% {
			transform: rotate(1.6deg);
		}
	}
	:global(html[data-theme='gta']) .tone-1 {
		background:
			radial-gradient(circle at 70% 30%, #ffe14d 0 14%, transparent 15%),
			linear-gradient(to bottom, #ff5fa2 0 55%, #2a0a4d 55%);
	}
	:global(html[data-theme='gta']) .tone-2 {
		background: linear-gradient(135deg, #8b2fe0, #ff2e93 60%, #ffd23f);
	}
	:global(html[data-theme='gta']) .tone-3 {
		background: linear-gradient(to bottom, #19e3d8 0 45%, #ff7a3d 45% 60%, #2a0a4d 60%);
	}

	.vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 45%, transparent 35%, rgba(var(--vig, 5, 20, 18), 0.65) 100%);
	}

	@keyframes grid-run {
		to {
			transform: translateY(80px);
		}
	}
	@keyframes sun-breathe {
		50% {
			transform: translateY(1.2vh) scale(1.03);
		}
	}
	@keyframes drift {
		0%,
		100% {
			transform: translateY(-0.6rem) rotateZ(var(--r)) rotateY(var(--ry));
		}
		50% {
			transform: translateY(0.8rem) rotateZ(calc(var(--r) * -0.5)) rotateY(calc(var(--ry) * -0.7));
		}
	}

	@media (max-width: 52rem) {
		.prints {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.car {
			animation: none;
			display: none !important;
		}
		.palm {
			animation: none;
		}
		.grid,
		.sun,
		.print-inner {
			animation: none;
		}
		.print-inner {
			transform: rotateZ(var(--r)) rotateY(var(--ry));
		}
		.stage {
			transform: none;
		}
	}
</style>

<script>
	// Gentle parallax: the whole scene leans toward the pointer, or the phone's tilt.
	const scene = document.querySelector<HTMLElement>('.scene');
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (scene && !calm) {
		const lean = (x: number, y: number) => {
			scene.style.setProperty('--mx', String(Math.max(-1, Math.min(1, x))));
			scene.style.setProperty('--my', String(Math.max(-1, Math.min(1, y))));
		};
		window.addEventListener(
			'pointermove',
			(e) => lean((e.clientX / innerWidth - 0.5) * 2, (e.clientY / innerHeight - 0.5) * 2),
			{ passive: true },
		);
		window.addEventListener(
			'deviceorientation',
			(e) => {
				if (e.gamma != null && e.beta != null) lean(e.gamma / 30, (e.beta - 45) / 30);
			},
			{ passive: true },
		);
	}
</script>
