---
// Miami theme music player. Music only, no video.
// Plays an uploaded audio file if there is one (full song), otherwise a Spotify song in Spotify's slim player.
// Both are set in /admin (Music player).
import music from '../content/music.json';

const m = music as { title: string; artist: string; audio?: string; spotify?: string };
const audio = m.audio || '';
const spotifyId = /track\/([A-Za-z0-9]{22})/.exec(m.spotify ?? '')?.[1] ?? '';
const mode = audio ? 'audio' : spotifyId ? 'spotify' : '';
---

{
	mode && (
		<aside class={`player mode-${mode}`} aria-label="Music player" data-player data-mode={mode} data-spotify={spotifyId}>
			{mode === 'audio' && (
				<div class="pl-head">
					<div class="eq" aria-hidden="true">
						<i />
						<i />
						<i />
						<i />
					</div>
					<div class="pl-meta">
						<p class="pl-now">Now playing</p>
						<p class="pl-title">
							{m.title}
							<span>{m.artist}</span>
						</p>
					</div>
					<button class="pl-btn" type="button" data-toggle aria-label="Play music">
						<svg class="i-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M7 4.5v15l13-7.5z" fill="currentColor" />
						</svg>
						<svg class="i-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M6 4.5h4v15H6zM14 4.5h4v15h-4z" fill="currentColor" />
						</svg>
					</button>
					<audio src={audio} preload="none" loop data-audio />
				</div>
			)}
			{mode === 'spotify' && <div class="sp-slot"><div id="sp-embed" /></div>}
		</aside>
	)
}

<style>
	.player {
		display: none;
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 60;
		width: min(21rem, calc(100vw - 2rem));
		padding: 0.6rem;
		border-radius: 14px;
		background: linear-gradient(160deg, rgba(42, 10, 77, 0.94), rgba(18, 5, 43, 0.96));
		border: 2px solid var(--neon, #19e3d8);
		box-shadow: 0 0 26px rgba(25, 227, 216, 0.4), 6px 6px 0 rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(8px);
		color: #fff;
	}
	:global(html[data-theme='gta']) .player {
		display: block;
	}
	.mode-spotify {
		padding: 0.35rem;
	}
	.sp-slot {
		min-height: 80px;
		border-radius: 12px;
		overflow: hidden;
	}
	.sp-slot :global(iframe) {
		display: block;
		width: 100%;
		border: 0;
	}
	.pl-head {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}
	.eq {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 1.8rem;
		flex: none;
	}
	.eq i {
		display: block;
		width: 5px;
		height: 30%;
		border-radius: 2px;
		background: linear-gradient(to top, #ff2e93, #ffd23f);
	}
	.player.playing .eq i {
		animation: bounce 0.9s ease-in-out infinite;
	}
	.eq i:nth-child(2) { animation-delay: -0.3s; }
	.eq i:nth-child(3) { animation-delay: -0.6s; }
	.eq i:nth-child(4) { animation-delay: -0.15s; }
	@keyframes bounce {
		0%, 100% { height: 25%; }
		50% { height: 100%; }
	}
	.pl-meta {
		flex: 1;
		min-width: 0;
	}
	.pl-meta p {
		margin: 0;
		line-height: 1.2;
	}
	.pl-now {
		font-size: 0.78rem;
		color: var(--neon, #19e3d8);
		font-weight: 700;
	}
	.pl-title {
		font-weight: 800;
		font-size: 1rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pl-title span {
		font-weight: 500;
		color: #cdb8ee;
		margin-left: 0.4rem;
		font-size: 0.85rem;
	}
	.pl-btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.8rem;
		height: 2.8rem;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: #1a0630;
		background: linear-gradient(135deg, #ffd23f, #ff2e93);
		box-shadow: 0 0 16px rgba(255, 46, 147, 0.6);
		transition: transform 0.12s;
	}
	.pl-btn:hover {
		transform: scale(1.1);
	}
	.i-pause { display: none; }
	.player.playing .i-play { display: none; }
	.player.playing .i-pause { display: block; }
	@media (max-width: 40rem) {
		.player {
			right: 0.5rem;
			bottom: 0.5rem;
			width: calc(100vw - 1rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.eq i { animation: none !important; }
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-player]');
	const gta = document.documentElement.dataset.theme === 'gta';

	if (root && gta) {
		const win = window as any;
		let wantPlay = false;
		let play = () => {};

		if (root.dataset.mode === 'audio') {
			const el = root.querySelector<HTMLAudioElement>('[data-audio]')!;
			const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
			const setPlaying = (on: boolean) => {
				root.classList.toggle('playing', on);
				toggle.setAttribute('aria-label', on ? 'Pause music' : 'Play music');
			};
			el.addEventListener('play', () => setPlaying(true));
			el.addEventListener('pause', () => setPlaying(false));
			play = () => void el.play().catch(() => {});
			toggle.addEventListener('click', () => (el.paused ? play() : el.pause()));
		} else {
			// Spotify's slim player (music only). It loads Spotify's own script.
			let controller: any = null;
			play = () => {
				wantPlay = true;
				controller?.play();
			};
			win.onSpotifyIframeApiReady = (api: any) => {
				const target = document.getElementById('sp-embed');
				api.createController(
					target,
					{ uri: `spotify:track:${root.dataset.spotify}`, width: '100%', height: 80, theme: 0 },
					(c: any) => {
						controller = c;
						c.addListener('playback_update', (e: any) => root.classList.toggle('playing', !e.data.isPaused));
						if (wantPlay) c.play();
					},
				);
			};
			const tag = document.createElement('script');
			tag.src = 'https://open.spotify.com/embed/iframe-api/v1';
			tag.async = true;
			document.head.appendChild(tag);
		}

		// The intro screen asks people to press start; that tap is what lets the music begin.
		document.addEventListener('hobley:start', play);
	}
</script>
