---
// Miami theme radio. Sits centred at the bottom of each page (on the home page, under the social icons).
// Plays an uploaded audio file if there is one (full song), otherwise a Spotify song, playlist or album in Spotify's player.
// Both are set in /admin (Music player).
import music from '../content/music.json';

const m = music as { title: string; artist: string; audio?: string; spotify?: string };
const audio = m.audio || '';
const sp = /(track|playlist|album)\/([A-Za-z0-9]{22})/.exec(m.spotify ?? '');
const kind = sp?.[1] ?? '';
const id = sp?.[2] ?? '';
const mode = audio ? 'audio' : id ? 'spotify' : '';
---

{
	mode && (
		<section
			class={`player mode-${mode}`}
			aria-label="Music player"
			data-player
			data-mode={mode}
			data-kind={kind}
			data-spotify={id}
		>
			<div class="pl-head">
				<div class="eq" aria-hidden="true">
					<i />
					<i />
					<i />
					<i />
					<i />
				</div>
				<div class="pl-meta">
					<p class="pl-now">Now playing</p>
					<p class="pl-title">
						{m.title}
						<span>{m.artist}</span>
					</p>
				</div>
				{mode === 'audio' && (
					<button class="pl-btn" type="button" data-toggle aria-label="Play music">
						<svg class="i-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M7 4.5v15l13-7.5z" fill="currentColor" />
						</svg>
						<svg class="i-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M6 4.5h4v15H6zM14 4.5h4v15h-4z" fill="currentColor" />
						</svg>
					</button>
				)}
			</div>
			{audio && <audio src={audio} preload="none" loop data-audio />}
			{mode === 'spotify' && (
				<div class="sp-slot">
					<div id="sp-embed" />
				</div>
			)}
		</section>
	)
}

<style>
	.player {
		display: none;
		position: relative;
		width: min(26rem, calc(100% - 2 * var(--gutter)));
		margin: 2.75rem auto 0;
		padding: 0.9rem 0.9rem 0.9rem;
		border-radius: 18px;
		background: linear-gradient(165deg, rgba(60, 14, 100, 0.85), rgba(18, 5, 43, 0.92));
		border: 2px solid var(--neon, #19e3d8);
		box-shadow: 0 0 30px rgba(25, 227, 216, 0.4), 0 0 60px rgba(255, 46, 147, 0.2), 6px 6px 0 rgba(0, 0, 0, 0.45);
		color: #fff;
		overflow: hidden;
	}
	:global(html[data-theme='gta']) .player {
		display: block;
	}
	/* sunset stripes along the top edge, like the rest of the theme */
	.player::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 0.4rem;
		background: linear-gradient(90deg, #ffd23f, #ff7a3d 50%, #ff2e93);
	}
	.pl-head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin: 0.35rem 0 0.8rem;
	}
	.eq {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 2rem;
		flex: none;
	}
	.eq i {
		display: block;
		width: 5px;
		height: 22%;
		border-radius: 2px;
		background: linear-gradient(to top, #ff2e93, #ffd23f);
	}
	.player.playing .eq i {
		animation: bounce 0.9s ease-in-out infinite;
	}
	.eq i:nth-child(2) { animation-delay: -0.3s; }
	.eq i:nth-child(3) { animation-delay: -0.6s; }
	.eq i:nth-child(4) { animation-delay: -0.15s; }
	.eq i:nth-child(5) { animation-delay: -0.45s; }
	@keyframes bounce {
		0%, 100% { height: 22%; }
		50% { height: 100%; }
	}
	.pl-meta {
		flex: 1;
		min-width: 0;
	}
	.pl-meta p {
		margin: 0;
		line-height: 1.25;
	}
	.pl-now {
		font-size: 0.8rem;
		color: var(--neon, #19e3d8);
		font-weight: 700;
	}
	.pl-title {
		font-family: var(--display);
		font-size: 1.15rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		background: linear-gradient(90deg, #ffe14d, #ff8a3d 55%, #ff2e93);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.pl-title span {
		display: block;
		margin-top: 0.1rem;
		font-family: var(--text);
		font-weight: 600;
		font-size: 0.85rem;
		color: #cdb8ee;
		-webkit-text-fill-color: #cdb8ee;
	}
	.pl-btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.9rem;
		height: 2.9rem;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: #1a0630;
		background: linear-gradient(135deg, #ffd23f, #ff2e93);
		box-shadow: 0 0 18px rgba(255, 46, 147, 0.6);
		transition: transform 0.12s;
	}
	.pl-btn:hover {
		transform: scale(1.1);
	}
	.i-pause { display: none; }
	.player.playing .i-play { display: none; }
	.player.playing .i-pause { display: block; }

	.sp-slot {
		border-radius: 12px;
		overflow: hidden;
		background: #12052b;
		box-shadow: 0 0 0 2px rgba(255, 46, 147, 0.5);
	}
	.sp-slot :global(iframe) {
		display: block;
		width: 100%;
		border: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.eq i { animation: none !important; }
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-player]');
	const gta = document.documentElement.dataset.theme === 'gta';

	if (root && gta) {
		const win = window as any;
		let wantPlay = false;
		let play = () => {};

		if (root.dataset.mode === 'audio') {
			const el = root.querySelector<HTMLAudioElement>('[data-audio]')!;
			const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
			const setPlaying = (on: boolean) => {
				root.classList.toggle('playing', on);
				toggle.setAttribute('aria-label', on ? 'Pause music' : 'Play music');
			};
			el.addEventListener('play', () => setPlaying(true));
			el.addEventListener('pause', () => setPlaying(false));
			play = () => void el.play().catch(() => {});
			toggle.addEventListener('click', () => (el.paused ? play() : el.pause()));
		} else {
			// Spotify's own player (song, playlist or album). It loads Spotify's script.
			const kind = root.dataset.kind || 'track';
			let controller: any = null;
			play = () => {
				wantPlay = true;
				controller?.play();
			};
			win.onSpotifyIframeApiReady = (api: any) => {
				api.createController(
					document.getElementById('sp-embed'),
					{
						uri: `spotify:${kind}:${root.dataset.spotify}`,
						width: '100%',
						height: kind === 'track' ? 80 : 352,
						theme: 0,
					},
					(c: any) => {
						controller = c;
						c.addListener('playback_update', (e: any) => root.classList.toggle('playing', !e.data.isPaused));
						if (wantPlay) c.play();
					},
				);
			};
			const tag = document.createElement('script');
			tag.src = 'https://open.spotify.com/embed/iframe-api/v1';
			tag.async = true;
			document.head.appendChild(tag);
		}

		// The intro screen asks people to press start; that tap is what lets the music begin.
		document.addEventListener('hobley:start', play);
	}
</script>
