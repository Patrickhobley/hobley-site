---
// Short intro shown once per visit: stripes sweep across, the name pops in, then the screen lifts away.
const word = 'hobley';
---

<script is:inline>
	// Skip the intro if it already played in this browser tab.
	try {
		var root = document.documentElement;
		var seen = sessionStorage.getItem('hobley-intro');
		if (seen) root.classList.add('seen');
		else sessionStorage.setItem('hobley-intro', '1');
		// Miami theme waits on the intro screen until someone presses start (that tap lets the music play).
		var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!seen && !calm && root.getAttribute('data-theme') === 'gta') {
			root.classList.add('hold');
			setTimeout(function () {
				root.classList.remove('hold');
			}, 40000);
		}
	} catch (e) {}
</script>

<div class="splash" aria-hidden="true">
	<div class="splash-word">
		{[...word].map((c, n) => <span class="sp-ch" style={`--n:${n}`}>{c}</span>)}
	</div>
	<div class="splash-bars"><span></span><span></span><span></span></div>
	<button class="splash-start" type="button" tabindex="-1">Press start</button>
</div>

<style>
	.splash {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 1.4rem;
		background: var(--wall);
		animation: lift 0.65s cubic-bezier(0.7, 0, 0.84, 0) 1.95s forwards;
	}
	.splash-word {
		font-family: var(--display);
		font-size: clamp(4.5rem, 22vw, 11rem);
		line-height: 1;
		color: var(--accent);
		text-shadow: 4px 4px 0 var(--stripe-3), 8px 8px 0 rgba(0, 0, 0, 0.35);
	}
	.sp-ch {
		display: inline-block;
		animation: letter 0.65s cubic-bezier(0.2, 0.9, 0.3, 1.5) both;
		animation-delay: calc(0.5s + var(--n) * 0.075s);
	}
	.splash-bars {
		display: grid;
		gap: 0.5rem;
		width: min(80vw, 38rem);
	}
	.splash-bars span {
		display: block;
		height: 1rem;
		border-radius: 999px;
		transform-origin: left;
		animation: sweep 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	.splash-bars span:nth-child(1) { background: var(--stripe-1); animation-delay: 0.1s; }
	.splash-bars span:nth-child(2) { background: var(--stripe-2); animation-delay: 0.25s; }
	.splash-bars span:nth-child(3) { background: var(--stripe-3); animation-delay: 0.4s; }

	.splash-start {
		display: none;
		margin-top: 1.2rem;
		padding: 0.8rem 1.6rem;
		border: 2px solid var(--neon, #19e3d8);
		border-radius: 999px;
		background: transparent;
		color: #fff;
		font: 800 1.15rem var(--text);
		letter-spacing: 0.08em;
		cursor: pointer;
		box-shadow: 0 0 22px rgba(25, 227, 216, 0.5);
		animation: blink 1.1s ease-in-out 1.7s infinite alternate both;
	}

	@keyframes blink {
		from { opacity: 0.25; }
	}
	@keyframes sweep {
		from { transform: scaleX(0); }
	}
	@keyframes letter {
		from { opacity: 0; transform: translateY(0.7em) rotate(-10deg) scale(0.5); }
	}
	@keyframes lift {
		to { transform: translateY(-100%); visibility: hidden; }
	}

	/* Page animations wait for the intro, unless it was already seen. */
	:global(html:not(.seen)) {
		--intro: 2.1s;
	}
	/* Miami theme: the screen stays until start is pressed */
	:global(html[data-theme='gta']:not(.seen)) {
		--intro: 0.3s;
	}
	:global(html[data-theme='gta']:not(.seen)) .splash {
		animation: none;
		cursor: pointer;
	}
	:global(html[data-theme='gta']:not(.seen)) .splash-start {
		display: block;
	}
	.splash.leave {
		animation: lift 0.65s cubic-bezier(0.7, 0, 0.84, 0) forwards !important;
	}
	:global(html.seen) .splash {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.splash {
			display: none;
		}
	}
</style>

<script>
	const splash = document.querySelector<HTMLElement>('.splash');
	const root = document.documentElement;
	if (splash && root.classList.contains('hold')) {
		const start = () => {
			root.classList.remove('hold');
			splash.classList.add('leave');
			document.dispatchEvent(new Event('hobley:start'));
			splash.removeEventListener('click', start);
			removeEventListener('keydown', onKey);
		};
		const onKey = (e: KeyboardEvent) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				start();
			}
		};
		splash.addEventListener('click', start);
		addEventListener('keydown', onKey);
	}
</script>
