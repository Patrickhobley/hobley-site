---
import type { GalleryItem } from '../lib/gallery';

interface Props {
	items: GalleryItem[];
}

const { items } = Astro.props;
---

<ul class="grid" data-grid>
	{
		items.map((item) => (
			<li>
				<button
					type="button"
					class="tile"
					data-tile
					data-title={item.title}
					data-caption={item.caption}
					data-alt={item.alt}
					data-kind={item.kind}
					data-image={item.image ?? ''}
					data-embed={item.embed ?? ''}
					data-video-file={item.videoFile ?? ''}
					data-tag-slugs={item.tags.map((t) => t.slug).join(' ')}
					data-tag-titles={item.tags.map((t) => t.title).join(', ')}
					aria-label={item.kind === 'video' ? 'Play video' : 'View photo'}
				>
					<span class="tile-photo">
						{item.thumb ? (
							<img src={item.thumb} alt="" loading="lazy" decoding="async" data-fade />
						) : (
							<span class="tile-blank">{item.kind === 'video' ? 'Video' : 'Photo'}</span>
						)}
						{item.kind === 'video' && <span class="play" aria-hidden="true" />}
					</span>
				</button>
			</li>
		))
	}
</ul>

<dialog id="viewer" class="viewer" aria-label="Viewer">
	<div class="viewer-body">
		<button type="button" class="v-close" data-close aria-label="Close viewer">
			<span aria-hidden="true">&times;</span>
		</button>
		<div class="viewer-frame">
			<button type="button" class="v-nav v-prev" data-prev aria-label="Previous"><span aria-hidden="true">&lsaquo;</span></button>
			<div class="viewer-stage" data-stage></div>
			<button type="button" class="v-nav v-next" data-next aria-label="Next"><span aria-hidden="true">&rsaquo;</span></button>
		</div>
		<div class="viewer-info">
			<p class="viewer-count" data-viewer-count aria-live="polite"></p>
			<p class="viewer-caption" data-viewer-caption></p>
			<p class="viewer-tags" data-viewer-tags></p>
		</div>
	</div>
</dialog>

<script>
	const grid = document.querySelector('[data-grid]');
	const dialog = document.querySelector('#viewer');

	if (grid && dialog instanceof HTMLDialogElement) {
		const tiles = Array.from(grid.querySelectorAll('[data-tile]'));

		// Masonry: each print takes as many 8px rows as it is tall, so rows read left to right with no gaps or cropping
		const ROW = 8;
		const fit = (li) => {
			const tile = li.firstElementChild;
			if (!tile || li.hidden) return;
			const pad = parseFloat(getComputedStyle(li).paddingBottom) || 0;
			li.style.setProperty('--span', String(Math.ceil((tile.getBoundingClientRect().height + pad) / ROW)));
		};
		const sizer = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target.closest('li'))));
		grid.querySelectorAll('li').forEach((li) => {
			fit(li);
			sizer.observe(li.firstElementChild);
		});

		// Prints fade in as they load
		grid.querySelectorAll('img[data-fade]').forEach((img) => {
			const done = () => img.classList.add('in');
			if (img.complete && img.naturalWidth) done();
			else {
				img.addEventListener('load', done, { once: true });
				img.addEventListener('error', done, { once: true });
			}
		});
		const stage = dialog.querySelector('[data-stage]');
		const captionEl = dialog.querySelector('[data-viewer-caption]');
		const tagsEl = dialog.querySelector('[data-viewer-tags]');
		const countEl = dialog.querySelector('[data-viewer-count]');
		let current = 0;
		let direction = 0;

		const visibleTiles = () => tiles.filter((tile) => !tile.closest('li')?.hidden);

		function render(tile) {
			const d = tile.dataset;
			stage.replaceChildren();
			let el = null;
			if (d.embed) {
				el = document.createElement('iframe');
				el.src = d.embed;
				el.title = 'Video';
				el.allow = 'autoplay; fullscreen; picture-in-picture';
				el.allowFullscreen = true;
				el.className = 'embed';
			} else if (d.videoFile) {
				el = document.createElement('video');
				el.src = d.videoFile;
				el.controls = true;
				el.playsInline = true;
				el.autoplay = true;
				if (d.image) el.poster = d.image;
			} else if (d.image) {
				el = document.createElement('img');
				el.src = d.image;
				el.alt = d.alt || 'Photograph by Patrick Hobley';
				el.className = 'photo';
				el.dataset.dir = String(direction);
				const show = () => el.classList.add('in');
				el.addEventListener('load', show, { once: true });
				el.addEventListener('error', show, { once: true });
			}
			if (el) stage.append(el);
			const list = visibleTiles();
			const at = list.indexOf(tile);
			countEl.textContent = list.length > 1 && at >= 0 ? `${at + 1} of ${list.length}` : '';
			// Warm up the neighbours so Next and Previous feel instant
			[1, -1].forEach((n) => {
				const near = list[(at + n + list.length) % list.length];
				if (near && near !== tile && near.dataset.image && !near.dataset.videoFile && !near.dataset.embed) new Image().src = near.dataset.image;
			});
			captionEl.textContent = d.caption || '';
			tagsEl.textContent = d.tagTitles || '';
		}

		function open(tile) {
			direction = 0;
			current = Math.max(0, visibleTiles().indexOf(tile));
			render(tile);
			if (!dialog.open) dialog.showModal();
		}

		function step(dir) {
			const list = visibleTiles();
			if (!list.length) return;
			current = (current + dir + list.length) % list.length;
			direction = dir;
			render(list[current]);
		}

		tiles.forEach((tile) => tile.addEventListener('click', () => open(tile)));
		dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-prev]').addEventListener('click', () => step(-1));
		dialog.querySelector('[data-next]').addEventListener('click', () => step(1));
		dialog.addEventListener('close', () => stage.replaceChildren());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') step(1);
			if (event.key === 'ArrowLeft') step(-1);
		});

		// Swipe on touch screens
		let startX = 0;
		let startY = 0;
		stage.addEventListener('touchstart', (event) => {
			startX = event.touches[0].clientX;
			startY = event.touches[0].clientY;
		}, { passive: true });
		stage.addEventListener('touchend', (event) => {
			if (event.target instanceof HTMLVideoElement || event.target instanceof HTMLIFrameElement) return;
			const dx = event.changedTouches[0].clientX - startX;
			const dy = event.changedTouches[0].clientY - startY;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
		}, { passive: true });

		// Tag filter (only on the Work page)
		const chips = Array.from(document.querySelectorAll('[data-filter]'));
		const emptyNote = document.querySelector('[data-filter-empty]');
		const countNote = document.querySelector('[data-count]');

		function applyFilter(tag) {
			let shown = 0;
			tiles.forEach((tile) => {
				const slugs = (tile.dataset.tagSlugs || '').split(' ');
				const match = !tag
					? true
					: tag.startsWith('kind:')
						? tile.dataset.kind === tag.slice(5)
						: slugs.includes(tag);
				const li = tile.closest('li');
				if (li) li.hidden = !match;
				if (match) shown += 1;
			});
			chips.forEach((chip) => {
				chip.setAttribute('aria-pressed', String((chip.dataset.filter || '') === (tag || '')));
			});
			if (emptyNote) emptyNote.hidden = shown > 0;
			if (countNote) countNote.textContent = tag ? `Showing ${shown} of ${tiles.length}` : `${tiles.length} ${tiles.length === 1 ? 'print' : 'prints'}`;
		}

		if (countNote) countNote.textContent = `${tiles.length} ${tiles.length === 1 ? 'print' : 'prints'}`;
		if (chips.length) {
			const start = new URL(location.href).searchParams.get('tag') || '';
			const known = chips.some((chip) => chip.dataset.filter === start);
			applyFilter(known ? start : '');
			chips.forEach((chip) =>
				chip.addEventListener('click', () => {
					const tag = chip.dataset.filter || '';
					applyFilter(tag);
					const url = new URL(location.href);
					if (tag) url.searchParams.set('tag', tag);
					else url.searchParams.delete('tag');
					history.replaceState(null, '', url);
				}),
			);
		}
	}
</script>
