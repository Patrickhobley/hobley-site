---
// Simple flat icons drawn for this site, all on a 24 x 24 grid in the same chunky style.
interface Props {
	name: string;
}
const { name } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width="24"
	height="24"
	aria-hidden="true"
	focusable="false"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		name === 'instagram' ? (
			<>
				<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
				<circle cx="12" cy="12" r="4" />
				<circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
			</>
		) : name === 'x' ? (
			<path d="M5.5 4.5l13 15M18.5 4.5l-13 15" stroke-width="2.6" />
		) : name === 'youtube' ? (
			<path
				fill="currentColor"
				stroke="none"
				fill-rule="evenodd"
				d="M6.5 5h11a4.5 4.5 0 0 1 4.5 4.5v5a4.5 4.5 0 0 1-4.5 4.5h-11A4.5 4.5 0 0 1 2 14.5v-5A4.5 4.5 0 0 1 6.5 5zM10 8.9v6.2l5.3-3.1z"
			/>
		) : name === 'twitch' ? (
			<path
				fill="currentColor"
				stroke="none"
				fill-rule="evenodd"
				d="M4 3h16.5v11.5L16 19h-3.5l-3 3v-3H4zM10 7v5h1.7V7zM14.3 7v5H16V7z"
			/>
		) : name === 'steam' ? (
			<>
				<circle cx="12" cy="12" r="9.5" />
				<circle cx="14.6" cy="9.6" r="2.6" />
				<circle cx="8.8" cy="14.8" r="1.9" />
				<path d="M10.2 13.7l3-2.2" />
			</>
		) : name === 'spotify' ? (
			<>
				<circle cx="12" cy="12" r="9.5" />
				<path d="M6.6 9.4c3.6-1 7.4-.8 10.8 1.1" />
				<path d="M7.5 12.8c3-.8 6-.5 8.9.9" />
				<path d="M8.5 16c2.3-.6 4.6-.4 6.8.7" />
			</>
		) : name === 'linkedin' ? (
			<>
				<rect x="3.5" y="3.5" width="17" height="17" rx="3" />
				<path d="M8 10.5v6M8 7.8v.2M12 16.5v-6M12 13c0-1.6 1.1-2.5 2.5-2.5s2.5.9 2.5 2.5v3.5" />
			</>
		) : name === 'email' ? (
			<>
				<rect x="3" y="5.5" width="18" height="13" rx="3" />
				<path d="M4 8l8 5.5L20 8" />
			</>
		) : (
			<>
				<circle cx="12" cy="12" r="9.5" />
				<path d="M2.5 12h19M12 2.5c3 3 3 16 0 19M12 2.5c-3 3-3 16 0 19" />
			</>
		)
	}
</svg>
