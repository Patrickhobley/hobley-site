---
import Base from '../layouts/Base.astro';
import { EMAIL, LINKEDIN } from '../consts';
---

<Base title="Contact" description="Contact Patrick Hobley about photography, video and content work.">
	<section class="block narrow prose">
		<h1 class="page-title">Contact</h1>
		<p class="lede">
			For photography, video or content work, email me with what you need and when you need it.
		</p>
		<p><a class="big-link" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
		<p>You can also find me on <a href={LINKEDIN} rel="noopener">LinkedIn</a>.</p>
	</section>
</Base>
