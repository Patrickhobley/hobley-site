---
import Base from '../layouts/Base.astro';

const roles = [
	{
		when: '2021 to now',
		what: 'Press/Media Photographer, Alamy',
		detail: 'Photography for the Alamy picture library.',
	},
	{
		when: '2021 to now',
		what: 'Press/Media Videographer, Newsflare',
		detail: 'Video for the Newsflare news and viral video platform.',
	},
	{
		when: '2020 to 2025',
		what: 'Director, Virtual Tour Network',
		detail:
			'Professional interior and exterior property photography for estate agents including Rightmove and Savills, plus venues and pop-up events such as music festivals. I grew its client network.',
	},
	{
		when: '2020 to 2022',
		what: 'Social media marketing consultant, self-employed',
		detail: 'Social media marketing consultancy, including Meta-based marketing and short-form video.',
	},
	{
		when: 'Nov 2019 to Apr 2020',
		what: 'Social Media Marketing Specialist, Dods Group PLC',
		detail:
			'B2B marketing on LinkedIn and Twitter, in-house politics publications, and several large social media pages in the political space.',
	},
	{
		when: 'Mar 2017 to 2019',
		what: 'Britannic Bi-Fold Company',
		detail:
			'Built the company social media from scratch, put an SEO strategy into the marketing and grew the client base, with 70% of jobs coming from the website.',
	},
];
---

<Base
	title="About"
	description="About Patrick Hobley: photographer, videographer and content creator in Nutley, East Sussex."
>
	<section class="block narrow prose">
		<h1 class="page-title">About</h1>
		<p class="lede">
			I'm a content creator based in Nutley, East Sussex. I take the photographs, edit short-form
			video and plan the content around them.
		</p>
		<p>
			My photography covers property interiors and exteriors, festivals and events, and press
			work. On the marketing side I work with Meta platforms and LinkedIn B2B, and edit short-form
			video.
		</p>

		<h2>Experience</h2>
		<ol class="timeline">
			{
				roles.map((role) => (
					<li>
						<p class="when">{role.when}</p>
						<h3>{role.what}</h3>
						<p>{role.detail}</p>
					</li>
				))
			}
		</ol>

		<h2>Training and tools</h2>
		<p>
			Google Analytics Individual Qualification (2019) and ICAAL Marketing Academy certifications.
			I edit photos in Adobe Lightroom.
		</p>

		<p><a href="/contact">Get in touch</a></p>
	</section>
</Base>
