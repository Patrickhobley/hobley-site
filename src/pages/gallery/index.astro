---
import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGallery } from '../../lib/gallery';
import '../../styles/gallery.css';

const { items, usedTags } = await getGallery();
const photos = items.filter((i) => i.kind === 'image').length;
const videos = items.filter((i) => i.kind === 'video').length;
---

<Base
	title="Gallery"
	description="Photography and video by Patrick Hobley: property interiors and exteriors, festivals, events and press."
	scene={false}
>
	<div class="g-menu" slot="extra">
		<nav aria-label="Gallery categories">
			<ul class="chips">
				<li>
					<button type="button" class="chip" data-filter="" aria-pressed="true">All</button>
				</li>
				{
					photos > 0 && (
						<li>
							<button type="button" class="chip" data-filter="kind:image" aria-pressed="false">
								Photos
							</button>
						</li>
					)
				}
				{
					videos > 0 && (
						<li>
							<button type="button" class="chip" data-filter="kind:video" aria-pressed="false">
								Videos
							</button>
						</li>
					)
				}
				{
					usedTags.map((tag) => (
						<li>
							<button type="button" class="chip" data-filter={tag.slug} aria-pressed="false">
								{tag.title}
							</button>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<section class="g-wrap">
		<h1 class="g-title"><SplitText text="Gallery" /></h1>
		<p class="g-lede">Photography and video: property, festivals, events and press. Pick a category above, or tap any print to see it full size.</p>
		{
			items.length > 0 ? (
				<>
					<GalleryGrid items={items} />
					<p class="g-empty" data-filter-empty hidden>
						Nothing in this category yet.
					</p>
				</>
			) : (
				<p class="g-empty">New work is on its way. Check back soon.</p>
			)
		}
	</section>
</Base>
