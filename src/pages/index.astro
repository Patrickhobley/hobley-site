---
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { getGallery } from '../lib/gallery';

const { items, usedTags } = await getGallery();
const recent = [...items]
	.sort((a, b) => Number(b.featured) - Number(a.featured))
	.slice(0, 9);
---

<Base>
	<section class="hero">
		<h1>Patrick Hobley</h1>
		<div class="stripes" aria-hidden="true"><span></span><span></span><span></span></div>
		<p class="lede">
			I photograph and film property interiors and exteriors, festivals, events and press work, and
			plan and produce the content around it. Based in Sussex.
		</p>
		{
			usedTags.length > 0 && (
				<ul class="chips" aria-label="Browse work by tag">
					{usedTags.map((tag) => (
						<li>
							<a class="chip" href={`/gallery?tag=${tag.slug}`}>
								{tag.title}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<section class="block">
		<div class="block-head">
			<h2>Recent work</h2>
			{items.length > 0 && <a href="/gallery">See all work</a>}
		</div>
		{
			items.length > 0 ? (
				<GalleryGrid items={recent} />
			) : (
				<p class="empty">New work is on its way. Check back soon.</p>
			)
		}
	</section>

	<section class="block narrow">
		<h2>Where the work has appeared</h2>
		<p>
			Property photography for estate agents including Rightmove and Savills. Press photos and
			video through Alamy and Newsflare. Event coverage at festivals such as Good Vibrations and
			Vegan Camp Out.
		</p>
		<p><a href="/about">More about me</a></p>
	</section>
</Base>
