---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import profile from '../content/profile.json';

const links = (await getCollection('links')).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<Base>
	<div class="links-page">
		<header class="profile">
			{
				profile.avatar && (
					<img class="avatar" src={profile.avatar} width="112" height="112" alt="" />
				)
			}
			<h1>{profile.name}</h1>
			{profile.subtitle && <p class="subtitle">{profile.subtitle}</p>}
			<div class="stripes" aria-hidden="true"><span></span><span></span><span></span></div>
		</header>

		{
			links.length > 0 ? (
				<ul class="link-list">
					{links.map((link) => (
						<li>
							<a
								class="link-button"
								href={link.data.url}
								target="_blank"
								rel={link.data.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}
							>
								{link.data.title}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">No links yet. Add some in the admin area.</p>
			)
		}
	</div>
</Base>
