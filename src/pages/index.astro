---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hobley</h1>
			<p>Welcome — this is the personal website of Patrick Hobley.</p>
			<p>
				It's built with <a href="https://astro.build/">Astro</a>, hosted on Cloudflare, and updated
				straight from <a href="https://github.com/Patrickhobley/hobley-site">GitHub</a>.
			</p>
			<p>Check out the <a href="/blog">blog</a> or read more <a href="/about">about me</a>.</p>
		</main>
		<Footer />
	</body>
</html>
