---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import SplitText from '../components/SplitText.astro';
import { getCollection } from 'astro:content';
import profile from '../content/profile.json';

const byOrder = (a: any, b: any) =>
	a.data.order - b.data.order || a.data.title.localeCompare(b.data.title);

const links = (await getCollection('links')).sort(byOrder);
const socials = (await getCollection('socials')).sort(byOrder);

const sectionDefs = [
	{ key: 'work', title: 'Work' },
	{ key: 'support', title: 'Support' },
	{ key: 'contact', title: 'Get in touch' },
];
let n = 0;
const sections = sectionDefs
	.map((def) => ({
		...def,
		items: links.filter((l) => l.data.group === def.key).map((link) => ({ link, i: n++ })),
	}))
	.filter((section) => section.items.length > 0);
const socialStart = n;

const isEmail = (url: string) => url.startsWith('mailto:');
// Links to this site open in the same tab and stay on whichever address you are using.
const isHome = (url: string) => /^https?:\/\/(www\.)?hobley\.me(\/|$)/.test(url);
const href = (url: string) => (isHome(url) ? url.replace(/^https?:\/\/(www\.)?hobley\.me/, '') || '/' : url);
---

<Base splash>
	<div class="links-page">
		<header class="profile">
			{
				profile.avatar && (
					<div class="avatar-wrap">
						<img class="avatar" src={profile.avatar} width="112" height="112" alt="" />
					</div>
				)
			}
			<h1><SplitText text={profile.name} /></h1>
			{profile.subtitle && <p class="subtitle">{profile.subtitle}</p>}
			{profile.intro && <p class="intro">{profile.intro}</p>}
			<div class="stripes" aria-hidden="true"><span></span><span></span><span></span></div>
		</header>

		{
			sections.length > 0 ? (
				sections.map((section) => (
					<section class="group" aria-labelledby={`g-${section.key}`}>
						<h2 class="group-title" id={`g-${section.key}`} style={`--i:${section.items[0].i}`}>
							{section.title}
						</h2>
						<ul class="link-list">
							{section.items.map(({ link, i }) => (
								<li style={`--i:${i}`}>
									<a
										class:list={['link-button', { featured: link.data.featured }]}
										href={href(link.data.url)}
										target={isEmail(link.data.url) || isHome(link.data.url) ? undefined : '_blank'}
										rel={
											isEmail(link.data.url) || isHome(link.data.url)
												? undefined
												: link.data.sponsored
													? 'noopener noreferrer sponsored'
													: 'noopener noreferrer'
										}
									>
										{link.data.title}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			) : (
				<p class="empty">No links yet. Add some in the admin area.</p>
			)
		}

		{
			socials.length > 0 && (
				<section class="group" aria-labelledby="g-follow">
					<h2 class="group-title" id="g-follow" style={`--i:${socialStart}`}>
						Follow
					</h2>
					<ul class="social-row">
						{socials.map((social, i) => (
							<li style={`--i:${socialStart + i}`}>
							<a
								class="social-icon"
								href={social.data.url}
								aria-label={social.data.title}
								title={social.data.title}
								target={isEmail(social.data.url) ? undefined : '_blank'}
								rel={isEmail(social.data.url) ? undefined : 'noopener noreferrer'}
							>
								<SocialIcon name={social.data.platform} />
							</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</Base>

<script>
	// Buttons and icons tilt toward the pointer for a little depth.
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const fine = window.matchMedia('(hover: hover)').matches;
	if (!calm && fine) {
		document.querySelectorAll<HTMLElement>('.link-button, .social-icon').forEach((el) => {
			el.addEventListener('pointermove', (e) => {
				const r = el.getBoundingClientRect();
				const x = (e.clientX - r.left) / r.width - 0.5;
				const y = (e.clientY - r.top) / r.height - 0.5;
				el.style.setProperty('--rx', `${(-y * 10).toFixed(1)}deg`);
				el.style.setProperty('--ry', `${(x * 12).toFixed(1)}deg`);
				el.style.setProperty('--sx', `${((x + 0.5) * 100).toFixed(0)}%`);
			});
			el.addEventListener('pointerleave', () => {
				el.style.setProperty('--rx', '0deg');
				el.style.setProperty('--ry', '0deg');
			});
		});
	}
</script>
