---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Scene from '../components/Scene.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** Turn off the 3D backdrop (used by the gallery so photos sit on a calm wall). */
	scene?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, scene = true } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead title={fullTitle} description={description} image={image} />
	</head>
	<body>
		{scene && <Scene />}
		<a class="skip" href="#content">Skip to content</a>
		<Header>
			<slot name="extra" slot="extra" />
		</Header>
		<main id="content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
