---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Scene from '../components/Scene.astro';
import Header from '../components/Header.astro';
import Splash from '../components/Splash.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** Turn off the 3D backdrop (used by the gallery so photos sit on a calm wall). */
	scene?: boolean;
	/** Play the short intro screen (home page only). */
	splash?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, scene = true, splash = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead title={fullTitle} description={description} image={image} />
	</head>
	<body>
		{splash && <Splash />}
		{scene ? <Scene /> : <Scene gtaOnly />}
		<a class="skip" href="#content">Skip to content</a>
		<Header>
			<slot name="extra" slot="extra" />
		</Header>
		<main id="content">
			<slot />
		</main>
		<Footer />
		<MusicPlayer />
	</body>
</html>
